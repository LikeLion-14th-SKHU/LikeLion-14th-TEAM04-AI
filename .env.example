# AI 파이프라인 환경 변수 — 복사해서 .env로 사용
# ⚠️ 값 뒤에 인라인 주석(#)을 달지 말 것 — 주석이 값으로 파싱됨. 주석은 반드시 별도 줄에.

ANTHROPIC_API_KEY=sk-ant-...

# Stage 3 (Nano Banana / Gemini 이미지 생성)
GOOGLE_API_KEY=

# Stage 4 (Meshy)
MESHY_API_KEY=

# Stage 4 품질 튜닝 (선택 — 기본값으로 시작해서 실물 보며 조정)
# 2k | 4k | 8k
MESHY_TEXTURE_RESOLUTION=2k
# 텍스처 텍스트 가이드 (영문, 600자 이내). 비우면 미사용.
MESHY_TEXTURE_PROMPT=

# live | replay
DEMO_MODE=live
